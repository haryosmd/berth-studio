{
  "name": "berth-studio",
  "private": true,
  "description": "Berth Studio: a database and API client for backend engineers.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/desktop"],
  "scripts": {
